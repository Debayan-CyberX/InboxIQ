{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://inboxiq-jpg5.onrender.com/api/:path*"
    },
    {
      "source": "/gmail/:path*",
      "destination": "https://inboxiq-jpg5.onrender.com/gmail/:path*"
    },
    {
      "source": "/health",
      "destination": "https://inboxiq-jpg5.onrender.com/health"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
